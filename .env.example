APP_NAME=DocuFlow AP
APP_ENV=local
APP_DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

REDIS_URL=redis://redis:6379/0

SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=replace_with_local_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_local_service_role_key
SUPABASE_JWT_SECRET=replace_with_local_jwt_secret

STORAGE_BUCKET_SOURCE_INVOICES=source-invoices
STORAGE_BUCKET_DERIVED_PAGES=derived-pages
STORAGE_BUCKET_EXPORTS=exports

MAX_UPLOAD_SIZE_MB=20
MAX_DOCUMENT_PAGES=30
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png
ALLOWED_CURRENCIES=USD

OCR_PROVIDER=tesseract
OCR_LANGUAGE=eng

DOCUMENT_RETENTION_DAYS=30
DERIVED_DATA_RETENTION_DAYS=90
