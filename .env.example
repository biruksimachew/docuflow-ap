APP_NAME=DocuFlow AP
APP_ENV=local
APP_DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:54322/postgres

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=replace_after_supabase_start
SUPABASE_SERVICE_ROLE_KEY=replace_after_supabase_start

STORAGE_BUCKET_SOURCE_INVOICES=source-invoices
STORAGE_BUCKET_DERIVED_PAGES=derived-pages
STORAGE_BUCKET_EXPORTS=exports

MAX_UPLOAD_SIZE_MB=20
MAX_DOCUMENT_PAGES=30
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png
ALLOWED_CURRENCIES=USD

OCR_PROVIDER=tesseract
OCR_LANGUAGE=eng

DOCUMENT_RETENTION_DAYS=30
DERIVED_DATA_RETENTION_DAYS=90
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=docuflow
S3_SECRET_KEY=docuflow-local-secret
S3_REGION=us-east-1
S3_BUCKET_SOURCE_INVOICES=source-invoices
S3_BUCKET_DERIVED_PAGES=derived-pages
PDF_RENDER_DPI=200
OCR_TASK_MAX_RETRIES=2
