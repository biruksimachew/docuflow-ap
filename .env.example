APP_NAME=DocuFlow AP
APP_ENV=local
APP_DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:54322/postgres

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=replace_after_supabase_start
SUPABASE_SERVICE_ROLE_KEY=replace_after_supabase_start

STORAGE_BUCKET_SOURCE_INVOICES=source-invoices
STORAGE_BUCKET_DERIVED_PAGES=derived-pages
STORAGE_BUCKET_EXPORTS=exports

MAX_UPLOAD_SIZE_MB=20
MAX_DOCUMENT_PAGES=30
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png
ALLOWED_CURRENCIES=USD

OCR_PROVIDER=tesseract
OCR_LANGUAGE=eng

DOCUMENT_RETENTION_DAYS=30
DERIVED_DATA_RETENTION_DAYS=90
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=docuflow
S3_SECRET_KEY=docuflow-local-secret
S3_REGION=us-east-1
S3_BUCKET_SOURCE_INVOICES=source-invoices
S3_BUCKET_DERIVED_PAGES=derived-pages
PDF_RENDER_DPI=200
OCR_TASK_MAX_RETRIES=2
VALIDATION_CURRENCY_TOLERANCE=0.01
INVOICE_FUTURE_TOLERANCE_DAYS=7
DECISION_HEADER_CONFIDENCE_MIN=0.90
DECISION_LINE_ITEM_CONFIDENCE_MIN=0.85
AUTH_ENFORCEMENT_ENABLED=true
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=replace-with-the-supabase-project-jwt-secret
# DOCUFLOW_NOTIFICATION_DELIVERY
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BASE_SECONDS=2
NOTIFICATION_RETRY_MAX_SECONDS=300
NOTIFICATION_DELIVERY_STALE_SECONDS=60
NOTIFICATION_WEBHOOK_TIMEOUT_SECONDS=10
NOTIFICATION_WEBHOOK_SIGNING_SECRET=replace-in-production
NOTIFICATION_WEBHOOK_ALLOWED_HOSTS=api,localhost,127.0.0.1
NOTIFICATION_EMAIL_PROVIDER=LOCAL_SINK
NOTIFICATION_EMAIL_FROM=docuflow@localhost.test
NOTIFICATION_SMTP_HOST=host.docker.internal
NOTIFICATION_SMTP_PORT=1025
NOTIFICATION_SMTP_TIMEOUT_SECONDS=10
NOTIFICATION_SMTP_USERNAME=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_SMTP_STARTTLS=false
# DOCUFLOW_OPERATIONS_DASHBOARD
FRONTEND_PORT=31000
DOCUFLOW_API_INTERNAL_URL=http://api:8000
DOCUFLOW_DEMO_AUTH_ENABLED=true
DOCUFLOW_SESSION_REFRESH_WINDOW_SECONDS=60
DOCUFLOW_LOCAL_AUTH_PASSWORD=DocuFlowLocal!2026
FRONTEND_PRODUCTION_PORT=31001
AUTH_JWT_ALGORITHMS=HS256,ES256
SUPABASE_JWKS_URL=http://host.docker.internal:54321/auth/v1/.well-known/jwks.json
